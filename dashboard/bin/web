#!/usr/bin/env python3
"""Run the web dashboard (dashboard/backend/server/__main__.py, through uv) for the current directory's repo.

Extra arguments go to the app, e.g. `web --port 8765`.
"""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))


def _enable_library() -> None:
    try:
        import orchestra.canon  # noqa: F401
    except ModuleNotFoundError:
        import pwd

        home = Path(pwd.getpwuid(os.getuid()).pw_dir)
        site_packages = home / ".local" / "lib" / f"python{sys.version_info.major}.{sys.version_info.minor}" / "site-packages"
        if site_packages.is_dir():
            sys.path.append(str(site_packages))


_enable_library()
from orchestra.canon.project import StoreBindingError, open_store  # noqa: E402

APP = Path(__file__).resolve().parent.parent / "backend" / "server" / "__main__.py"


def fail(message: str) -> int:
    print(message, flush=True)
    return 1


def find_uv() -> str | None:
    override = os.environ.get("ORCHESTRA_UV")
    if override:
        return override
    local = Path.home() / ".local" / "bin" / "uv"
    return shutil.which("uv") or (str(local) if os.access(local, os.X_OK) else None)


def main(argv: list[str]) -> int:
    try:
        target = open_store(Path.cwd())
    except StoreBindingError as exc:
        return fail(str(exc))
    uv = find_uv()
    if uv is None:
        return fail(
            "Cannot find uv, which runs the web dashboard.\n"
            "Install it: https://docs.astral.sh/uv/getting-started/installation/\n"
            "Or set ORCHESTRA_UV to its path."
        )
    command = [uv, "run", "--script", str(APP), *argv]
    try:
        os.chdir(target.project_root)
        os.execv(command[0], command)
    except OSError as exc:
        return fail(f"Cannot run {command[0]}: {exc}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
