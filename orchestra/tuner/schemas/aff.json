{
  "namespace": "aff",
  "version": "0.1.0",
  "types": {
    "check-run": {
      "purpose": "That this criterion was tested at a revision",
      "lifecycle": "event",
      "fields": {
        "criterion_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "blocked",
            "insufficient"
          ]
        },
        "effort": {
          "ref": "plan:effort"
        },
        "method": {
          "enum": [
            "tdd",
            "check",
            "manual",
            "review"
          ]
        },
        "signed_by": {
          "type": "string"
        },
        "requirement": {
          "type": "string",
          "optional": true
        },
        "evidence_kind": {
          "enum": [
            "unit",
            "integration",
            "acceptance",
            "static",
            "types",
            "security",
            "property",
            "fuzz",
            "review",
            "runtime",
            "other"
          ],
          "optional": true
        },
        "exit_code": {
          "type": "integer",
          "optional": true
        },
        "duration_s": {
          "type": "number",
          "optional": true
        },
        "output_sha256": {
          "type": "string",
          "optional": true
        },
        "runner": {
          "type": "string",
          "optional": true
        },
        "diff_sha256": {
          "type": "string",
          "optional": true
        },
        "failing_node_ids": {
          "list": {
            "type": "string"
          },
          "optional": true
        },
        "signed_note": {
          "type": "string",
          "optional": true
        },
        "informed_by": {
          "list": {
            "ref": [
              "plan:acceptance",
              "run:execution-report"
            ],
            "pin": true
          },
          "optional": true
        }
      }
    },
    "investigation-observation": {
      "purpose": "What was observed while diagnosing or evaluating",
      "lifecycle": "event",
      "fields": {
        "source": {
          "type": "string"
        },
        "observed_time": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "what_was_observed": {
          "type": "string"
        },
        "effort": {
          "ref": "plan:effort"
        }
      }
    },
    "evidence-binding": {
      "purpose": "An observation earning a claim under pinned base and head revisions",
      "lifecycle": "current",
      "fields": {
        "observation_id": {
          "type": "string"
        },
        "claim_id": {
          "type": "string"
        },
        "base_rev": {
          "type": "string"
        },
        "head_rev": {
          "type": "string"
        },
        "effort": {
          "ref": "plan:effort",
          "optional": true
        },
        "retired": {
          "type": "boolean",
          "optional": true
        }
      }
    },
    "finding": {
      "purpose": "Root cause or comparative evaluation conclusion",
      "lifecycle": "claim",
      "fields": {
        "claim": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "invalidated_when": {
          "type": "string"
        },
        "effort": {
          "ref": "plan:effort"
        },
        "needs": {
          "type": "string"
        },
        "resolution_note": {
          "type": "string",
          "optional": true
        },
        "contradicted_by": {
          "list": {
            "ref": "aff:finding",
            "pin": true
          },
          "optional": true
        },
        "severity": {
          "type": "string",
          "optional": true
        }
      },
      "sections": [
        "Evidence",
        "Consequence",
        "Follow-up"
      ]
    },
    "oracle-amendment": {
      "purpose": "Approved change to a frozen oracle on an acceptance (requested until parent approves or rejects)",
      "lifecycle": "current",
      "fields": {
        "acceptance": {
          "ref": "plan:acceptance"
        },
        "effort": {
          "ref": "plan:effort"
        },
        "phase": {
          "ref": "plan:phase"
        },
        "old_hashes": {
          "list": {
            "type": "string"
          }
        },
        "new_hashes": {
          "list": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "requested",
            "approved",
            "rejected"
          ]
        }
      },
      "sections": [
        "Reason",
        "Change"
      ]
    },
    "evidence-observation": {
      "purpose": "Trail of a technique run: revisions, structured outcome, and optional replay metadata",
      "lifecycle": "event",
      "fields": {
        "technique": {
          "type": "string"
        },
        "base_rev": {
          "type": "string"
        },
        "head_rev": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "claim_ids": {
          "list": {
            "type": "string"
          }
        },
        "effort": {
          "ref": "plan:effort",
          "optional": true
        },
        "replay": {
          "type": "string",
          "optional": true
        }
      }
    }
  },
  "migrations": []
}
