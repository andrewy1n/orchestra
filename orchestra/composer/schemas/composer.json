{
  "namespace": "composer",
  "version": "1.4.0",
  "types": {
    "area": {
      "purpose": "A named, long-lived product area",
      "lifecycle": "current",
      "fields": {
        "title": {
          "type": "string"
        }
      },
      "sections": [
        "Scope"
      ]
    },
    "placement": {
      "purpose": "Places one effort in one product area",
      "lifecycle": "current",
      "fields": {
        "area": {
          "ref": "composer:area"
        }
      }
    },
    "idea": {
      "purpose": "A product idea waiting to be triaged or promoted into an effort",
      "lifecycle": "current",
      "fields": {
        "status": {
          "enum": [
            "open",
            "promoted",
            "dismissed"
          ]
        },
        "area": {
          "ref": "composer:area",
          "optional": true
        },
        "effort": {
          "ref": "score:effort",
          "optional": true
        },
        "phase": {
          "ref": "score:phase",
          "optional": true
        },
        "source": {
          "type": "string",
          "optional": true
        }
      }
    },
    "product": {
      "purpose": "The one statement of what the product is for and who it serves",
      "lifecycle": "current",
      "fields": {
        "purpose": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        }
      }
    },
    "product-item": {
      "purpose": "One capability that exists now or one goal planned for the product",
      "lifecycle": "current",
      "fields": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "enum": [
            "current",
            "planned"
          ]
        }
      }
    },
    "component": {
      "purpose": "A named part of the system with one responsibility, placed in a product area",
      "lifecycle": "current",
      "fields": {
        "area": {
          "type": "string"
        }
      },
      "sections": [
        "Responsibility"
      ]
    },
    "interface": {
      "purpose": "A named boundary that provides something and connects components",
      "lifecycle": "current",
      "fields": {
        "connects": {
          "list": {
            "type": "string"
          }
        }
      },
      "sections": [
        "Provides"
      ]
    },
    "architecture-decision": {
      "purpose": "An architectural decision with its rationale and status, naming the components or interfaces it affects",
      "lifecycle": "current",
      "fields": {
        "status": {
          "enum": [
            "accepted",
            "proposed"
          ]
        },
        "affects": {
          "list": {
            "type": "string"
          }
        },
        "enforced_by": {
          "list": {
            "type": "string"
          },
          "optional": true
        }
      },
      "sections": [
        "Rationale"
      ]
    },
    "architecture-proposal": {
      "purpose": "A versioned ADR and constraint proposal for one phase",
      "lifecycle": "current",
      "fields": {
        "phase": {
          "ref": "score:phase"
        },
        "status": {
          "enum": [
            "pending",
            "withdrawn"
          ]
        },
        "adr": {
          "type": "string"
        },
        "affects": {
          "list": {
            "ref": [
              "composer:component",
              "composer:interface"
            ]
          }
        },
        "enforced_by": {
          "list": {
            "type": "string"
          },
          "optional": true
        },
        "base_adr": {
          "ref": "composer:architecture-decision",
          "pin": true,
          "optional": true
        },
        "base_adr_revision": {
          "type": "string",
          "optional": true
        },
        "constraints": {
          "list": {
            "ref": "composer:constraint-change",
            "pin": true
          },
          "optional": true
        }
      },
      "sections": [
        "Rationale"
      ]
    },
    "constraint-change": {
      "purpose": "An immutable candidate addition, revision, or retirement of a standing constraint",
      "lifecycle": "event",
      "fields": {
        "operation": {
          "enum": [
            "add",
            "revise",
            "retire"
          ]
        },
        "constraint": {
          "type": "string"
        },
        "base_constraint": {
          "ref": "score:standing-constraint",
          "pin": true,
          "optional": true
        },
        "base_constraint_revision": {
          "type": "string",
          "optional": true
        },
        "area": {
          "type": "string",
          "optional": true
        },
        "rule": {
          "type": "string",
          "optional": true
        },
        "check": {
          "type": "string",
          "optional": true
        },
        "targets": {
          "list": {
            "ref": [
              "composer:component",
              "composer:interface"
            ]
          },
          "optional": true
        }
      },
      "sections": [
        "Basis"
      ]
    }
  },
  "migrations": []
}
