{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orchestra hook-start --claude",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orchestra hook-stop --claude",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
