{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "orchestra hook-start --cursor"
      }
    ],
    "sessionEnd": [
      {
        "command": "orchestra hook-stop --cursor"
      }
    ],
    "stop": [
      {
        "command": "/home/andrewyin/.local/bin/cursor-watch-hook stop"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "/home/andrewyin/.local/bin/cursor-watch-hook afterAgentResponse"
      }
    ]
  }
}
