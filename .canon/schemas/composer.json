{
  "namespace": "composer",
  "version": "1.3.0",
  "types": {
    "area": {
      "purpose": "A named, long-lived product area",
      "lifecycle": "current",
      "fields": {
        "title": {
          "type": "string"
        }
      },
      "sections": [
        "Scope"
      ]
    },
    "placement": {
      "purpose": "Places one effort in one product area",
      "lifecycle": "current",
      "fields": {
        "area": {
          "ref": "composer:area"
        }
      }
    },
    "idea": {
      "purpose": "A product idea waiting to be triaged or promoted into an effort",
      "lifecycle": "current",
      "fields": {
        "status": {
          "enum": [
            "open",
            "promoted",
            "dismissed"
          ]
        },
        "area": {
          "ref": "composer:area",
          "optional": true
        },
        "effort": {
          "ref": "score:effort",
          "optional": true
        },
        "phase": {
          "ref": "score:phase",
          "optional": true
        },
        "source": {
          "type": "string",
          "optional": true
        }
      }
    },
    "product": {
      "purpose": "The one statement of what the product is for and who it serves",
      "lifecycle": "current",
      "fields": {
        "purpose": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        }
      }
    },
    "product-item": {
      "purpose": "One capability that exists now or one goal planned for the product",
      "lifecycle": "current",
      "fields": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "enum": [
            "current",
            "planned"
          ]
        }
      }
    },
    "component": {
      "purpose": "A named part of the system with one responsibility, placed in a product area",
      "lifecycle": "current",
      "fields": {
        "area": {
          "type": "string"
        }
      },
      "sections": [
        "Responsibility"
      ]
    },
    "interface": {
      "purpose": "A named boundary that provides something and connects components",
      "lifecycle": "current",
      "fields": {
        "connects": {
          "list": {
            "type": "string"
          }
        }
      },
      "sections": [
        "Provides"
      ]
    },
    "architecture-decision": {
      "purpose": "An architectural decision with its rationale and status, naming the components or interfaces it affects",
      "lifecycle": "current",
      "fields": {
        "status": {
          "enum": [
            "accepted",
            "proposed"
          ]
        },
        "affects": {
          "list": {
            "type": "string"
          }
        },
        "enforced_by": {
          "list": {
            "type": "string"
          },
          "optional": true
        }
      },
      "sections": [
        "Rationale"
      ]
    }
  },
  "migrations": []
}
